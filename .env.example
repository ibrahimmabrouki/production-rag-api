GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here


LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=Production-API


APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT=20/minute
CACHE_TTL_SECONDS=300
MAX_RETRIES=3

TOKEN_MAX_INPUT=4000
TOKEN_MAX_CHAT=20000
TOKEN_MAX_REQUESTS_PER_CHAT=50

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30

EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.90
SEMANTIC_CACHE_TOP_K=1

MONITORING_ENABLED=true
GRAFANA_OTLP_ENDPOINT=your_actual_endpoint
GRAFANA_INSTANCE_ID=your_actual_instance_id
GRAFANA_API_KEY=your_actual_api_key